# Neptune 360 SDK credentials — found on the SDK Access page in Neptune 360.
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
NEPTUNE_API_KEY=
NEPTUNE_CLIENT_ID=
NEPTUNE_CLIENT_SECRET=
NEPTUNE_SITE_ID=
NEPTUNE_HOST=aygpg477xh.execute-api.us-west-2.amazonaws.com

# Hard daily ceiling on API calls this app will make. Neptune told you 500/day;
# this is set a bit under that to leave headroom for token refreshes and manual use.
NEPTUNE_DAILY_CALL_BUDGET=480

# Sync & Backfill is disabled unless this is true. The quota above is only
# tracked per-database (api_call_log in THIS SQLite file) — Neptune's real
# 500/day cap is shared across every machine hitting the same site, so a
# local run can quietly eat into the budget the server thinks it still has.
# Leave false on every checkout except the one that should actually be
# syncing (normally just the deployed server).
NEPTUNE_ALLOW_SYNC=false

# Optional — enables the "Ask AI" tab. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Public deployment (e.g. exposing this on an AWS server) ---------------
# Set to true to require per-user email/password login to view the app at
# all. All tabs are always visible, but each one above your role shows a
# locked message instead of its real content. Three-tier role ladder:
#   viewer  — Customers / Water Usage / Continuous Users
#   admin   — viewer, plus Manage Users (can create viewer/admin accounts)
#   global  — everything, including Sync & Backfill and Ask AI
# Leave false for local/private use (no login prompt at all, full access).
NEPTUNE_PUBLIC_MODE=false

# One-time bootstrap: if NO global account exists yet in the database, the
# app creates one from these on startup (then never touches them again — a
# password changed later through the app won't get reset by these). Needed
# to get your first login; safe to leave set afterward.
NEPTUNE_SEED_GLOBAL_EMAIL=
NEPTUNE_SEED_GLOBAL_PASSWORD=
